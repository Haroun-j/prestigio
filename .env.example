# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git.

APP_ENV=dev
APP_SECRET=generate_a_random_32_char_string

# MySQL 8 (adapt user, password and database name)
DATABASE_URL="mysql://root:@127.0.0.1:3306/prestigio?serverVersion=8.0.32&charset=utf8mb4"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=smtp://localhost:1025
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

JWT_SECRET=generate_a_random_string

# Twilio (optional). When empty, the SMS code is displayed on the page.
TWILIO_DSN=twilio://SID:TOKEN@default?from=FROM
twilio_account_sid=
twilio_auth_token=
twilio_from_number=

# Stripe test secret key, needed for checkout: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# reCAPTCHA (optional)
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET=
RECAPTCHA3_KEY=my_site_key
RECAPTCHA3_SECRET=my_secret
