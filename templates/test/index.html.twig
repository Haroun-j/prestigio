{% extends 'base.html.twig' %}

{% block title %}TestController !{% endblock %}

{% block body %}
    <nav class="navbar fixed-top navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">
            <!-- Logo -->
            <a class="navbar-brand" href="#">
                <img src="../assets/IMG/img.png" alt="Logo" >
            </a>
            <div class="navbar-right">
                <div class="navbar-phone">
                    <button class="btn btn-success">
                        CLICK ME !!!!

                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <div id="clock"></div>
    </div>
    <div class="left-container">
        <img  src="../assets/IMG/crepes.png" id="crepe" alt="Logo">
        <h1>Pour des crèpes pour 3 personnes (dont votre professeur d'informatique), il faut :</h1>
        <table>
            <thead>
            <th>Ingrédient</th>
            <th>Quantité</th>
            </thead>
            <tbody>
            <tr>
            <td>farine</td>
            <td>250</td>
            </tr>
            <tr>
                <td>oeuf</td>
                <td>3</td>
            </tr>
            <tr>
                <td>sel</td>
                <td>1 pincée</td>
            </tr>
            <tr>
                <td>sucre vanillé</td>
                <td>1 sachet</td>
            </tr>
            <tr>
                <td>lait</td>
                <td>1/25 litre</td>
            </tr>
            <tr>
                <td>cognac</td>
                <td>2 bouchons</td>
            </tr>
            </tbody>
        </table>
        <h1>La préparation se fait en 3 étapes :</h1>
        <ol id="main_list">
            <li><strong>Pâte</strong>
            <ul>
                <li>Verser la farine, le sel et le sucre</li>
                <li>Casser les oeufs</li>
                <li>Melanger et délayez en versant le lait au fur et à mesure</li>
                <li>Ajouter le cognac</li>
            </ul>
            </li>
            <li><strong>Repos</strong>
                <ul>
                    <li>Laisser reposer la Pâte environ 2h</li>
                </ul>
            </li>
            <li><strong>Cuisson (à feu doux)</strong>
                <ol>
                    <li>Beurrer la crépière</li>
                    <li>Verser une louche, laisser cuire jusqu'à ce que la Pâte se décolle facilement avec une spatule</li>
                    <li>test-----------</li>
                    <li>test-----------</li>
                    <li>test-----------</li>
                </ol>
            </li>
        </ol>
    </div>
    <script>
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('clock').textContent = hours + ':' + minutes + ':' + seconds;
        }

        setInterval(updateClock, 1000);
        updateClock(); // Initial update
    </script>

    <style>
        body{
            margin: 0;
        }
        .fixed-top {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: #F5F5F5;
            box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);
            padding: 0px 13px;
        }

        .container-fluid {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
        }

        .navbar-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: center;
        }

        .navbar-phone .btn-success {
            background-color: #00b06b;
            border-radius: 12px;
            color: white;
            border: none;
            font-size: 24px;
            margin-top: -9px;
        }
        .navbar-brand img{
            height: 85px;
        }
        .container{
            display: flex;
            justify-content: center;
            margin: 0 190px;
            height: 160px;
            background: aliceblue;
            padding-top: 50px;
        }
        #clock {
            font-size: 60px;
            font-weight: bold;
            color: #333;
            background: radial-gradient(#c89696, transparent);
            padding: 24px;
            height: 59px;
        }
        table, th, td {
            border: 2px solid black;
        }
        .left-container{
            margin-left: 30px;
            margin-top: 50px;
        }
        #crepe{
            height: 189px;
            border: 2px solid #e8e83e;
            padding: 9px;
        }
        #main_list{
            font-size: 18px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        #main_list>li>ul, #main_list>li>ol {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
    </style>
{% endblock %}
