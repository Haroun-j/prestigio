{% block head %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/products/product_list.css') }}">
{% endblock %}

{% block body %}
    <header class="filter-aside">
        <ul class="indicator">
            <li data-filter="all" class="active"><a href="#">All</a></li>
            {% for category in storeData %}
                <li data-filter="{{ category.label }}"><a href="#">{{ category.label }}</a></li>
            {% endfor %}
        </ul>
        {#         ---------------Get items Number From session------------------ #}
        {#        {% set panier = app.session.get('panier', {}) %} #}
        {#        {% set itemCount = 0 %} #}
        {#        {% for quantity in panier %} #}
        {#            {% set itemCount = itemCount + quantity %} #}
        {#        {% endfor %} #}
        {#        <a href="{{ path('cart_index') }}"> #}
        {#            <i class="fa-solid fa-cart-shopping"></i> #}
        {#            {% if itemCount > 0 %} #}
        {#                <span class="cart-item-count">{{ itemCount }}</span> #}
        {#            {% endif %} #}
        {#        </a> #}
    </header>
    <main class="main-with-aside">
        {#        {% include './products/store/store_filter.html.twig' %} #}
        <aside>
            <div class="filter-condition">
                <span>Classer par: prix :</span>
                <select name="" id="select">
                    <option value="Default">Default</option>
                    <option value="LowToHigh">de bas en haut</option>
                    <option value="HighToLow">de haut en bas</option>
                </select>
            </div>
            <div class="product-field">
                <ul class="items">
                    {% for category in storeData %}
                        {% for product in category.products %}

                            <li data-category="{{ category.label }}" data-price="{{ product.price }}">
                                <a href="{{ path('product_details', {id: product.id}) }}" style="text-decoration: none">
                                    <picture>
                                        <img id="{{ product.name|replace({' ': '-'}) }}"
                                             src="{{ asset('uploads/images/products/' ~ product.imageName) }}" alt="">
                                    </picture>
                                </a>
                                <div class="detail">
                                    <p class="icon">
                                        <span><i class="far fa-heart"></i></span>
                                        <span><i class="far fa-share-square"></i></span>
                                        <a href="{{ path('cart_add', {id: product.id, size : 40, quantity: 1, source: 'store'}) }}"
                                           style="text-decoration: none"><span><i
                                                        class="fas fa-shopping-basket"></i></span></a>
                                    </p>
                                    <strong>{{ product.name | length > 20 ? product.name | slice(0, 18) ~ '...' : product.name }}</strong>
                                    <span>{{ product.description | length > 70 ? product.description | slice(0, 70) ~ '...' : product.description }}</span>


                                    <div class="colors" style="margin-bottom: 8px;">
                                        <!-- Active color -->
                                        <button class="color-button active-color"
                                                style="background: {{ product.colorCode }};"
                                                data-color-code="{{ product.colorCode }}" data-variation-info='{{ {
                                            name: product.name,
                                            sizes: product.sizes,
                                            image: asset('uploads/images/products/' ~ product.imageName)
                                        }|json_encode }}'></button>
                                        <!-- Other variations -->
                                        {% for variation in product.variations %}
                                            <button class="color-button" style="background: {{ variation.colorCode }};"
                                                    data-color-code="{{ variation.colorCode }}"
                                                    data-variation-info='{{ {
                                                        sizes: variation.sizes,
                                                        image: asset('assets/images/products/home/product_variations/' ~ product.name|replace({' ': '-'}) ~ '/' ~ variation.color|replace({' ': '-'}) ~ '-cropped.png')
                                                    }|json_encode }}'></button>
                                        {% endfor %}
                                    </div>
                                    <div class="sizes">
                                        {% for size in product.sizes %}
                                            <button data-size="{{ size.size }}">{{ size.size }}</button>
                                        {% endfor %}
                                    </div>


                                    <small><a style="text-decoration: none"
                                              href="{{ path('cart_add', {id: product.id, size : 42, quantity: 1, source: 'store'}) }}"
                                              class="buy-btn"
                                              data-route="{{ path('cart_add', {id: product.id, size : 42,quantity: 1, source: 'store'}) }}">Acheter</a></small>
                                </div>
                                <h4>${{ product.price }}</h4>
                            </li>

                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
            {{ include('@MercurySeriesFlashy/flashy.html.twig') }}
    </main>
    <style>
        .sizes, .colors {
            display: flex;
            justify-content: space-between;
            transition: all 0.75s ease-out;
            margin-top: 20px;
            margin-bottom: 5px;
            padding: 0 12px;
        }

        .sizes button, .colors button {
            padding: 0.5rem 1rem;
            background: none;
            border: none;
            box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);
            border-radius: 30px;
            cursor: pointer;
            font-weight: bold;
            color: #585858;
        }

        button.active-color {
            border: 2px solid black;
            transform: scale(1.15);
        }

        button.active-size {
            border: 2px solid black;
            transform: scale(1.15);
            background: #585858;
            color: white;
        }

        button.active {
            background: #585858;
            color: white;
        }

        #RACER-TR23 {
            margin-top: 86px;
        }
    </style>
    <script>
        new Vue({
            el: '#app',
            data: {
                filters: [{
                    id: 1,
                    title: 'Size',
                    content: ['One-Size', 'XS', 'S', 'M', 'L', 'XL', 'XXL'],
                    show: true,
                    defaultLimit: 4,
                    limitBy: 4
                },
                    {
                        id: 2,
                        title: 'Color',
                        content: ['White', 'Black', 'Grey', 'Purple', 'Blue', 'Green', 'Yellow', 'Orange', 'Red', 'Pink', 'Brown', 'Multicolor'],
                        show: true,
                        defaultLimit: 6,
                        limitBy: 6,
                        color: ['linear-gradient(45deg, rgba(247,250,255,1) 0%, rgba(255,255,255,1) 50%)', '#292c36', '#929abe', '#8667f7', '#5c9dff', '#9bec3e', '#ffe761', '#ffbc58', '#ff6f6f', '#ff74c0', '#c59864', ' linear-gradient(43deg, #4158D0 0%, #C850C0 46%, #FFCC70 100%)']
                    },
                    {
                        id: 3,
                        title: 'Material',
                        content: ['Cotton', 'Polyester', 'Rayon', 'Satin', 'Acrylic', 'Nylon', 'Velvet', 'Viscose', 'Crochet', 'Glitter', 'Lace', 'Corduroy', 'Linen', 'Metallic'],
                        show: false,
                        defaultLimit: 5,
                        limitBy: 5
                    },
                    {
                        id: 4,
                        title: 'Price',
                        content: [''],
                        show: false,
                        value: 50,
                        value2: 10
                    }
                ],
                checkedItems: [],
                min: 10,
                max: 200,
                step: 10,
                values: [10, 200],
                totalSteps: 0,
                percentPerStep: 1,
                dragging: false,
                price: 100,
                inputRight: 50,
                inputLeft: 20,
                valueRight: 50,
                valueLeft: 20,
                valueDifferent: ''
            },
            methods: {
                openFilter(filter) {
                    filter.show = !filter.show;
                },
                toggleShow(index, event) {
                    let currentFilter = this.filters[index];

                    if (currentFilter.limitBy === currentFilter.defaultLimit) {
                        this.filters[index].limitBy = currentFilter.content.length;
                        event.target.innerHTML = '- Show less';
                    } else {
                        this.filters[index].limitBy = currentFilter.defaultLimit;
                        event.target.innerHTML = '+ Show more';
                    }
                },
                deleteItem(index) {
                    this.checkedItems.splice(index, 1);
                },
                changeLeft() {
                    return this.valueLeft = Math.min(this.valueLeft, this.valueRight);
                },
                changeRight() {
                    return this.valueRight = Math.max(this.valueRight, this.valueLeft);
                }
            }
        });
    </script>
    <script type="text/javascript" src="{{ asset('assets/js/products/product_list.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const colorButtons = document.querySelectorAll('.color-button');
            colorButtons.forEach(button => {
                button.addEventListener('click', function () {
                    if (this.classList.contains('active-color')) {
                        return;
                    }

                    const productBox = this.closest('li');
                    const variationInfo = JSON.parse(this.dataset.variationInfo);

                    productBox.querySelector('img').src = variationInfo.image;
                    productBox.querySelector('img').style.marginTop = "86px";

                    const sizesContainer = productBox.querySelector('.sizes');
                    sizesContainer.innerHTML = '';
                    if (variationInfo.sizes && Array.isArray(variationInfo.sizes)) {
                        variationInfo.sizes.forEach(size => {
                            const sizeButton = document.createElement('button');
                            sizeButton.textContent = size.size;
                            sizeButton.dataset.size = size.size;
                            sizeButton.addEventListener('click', function () {
                                sizesContainer.querySelectorAll('button').forEach(btn => btn.classList.remove('active-size'));
                                this.classList.add('active-size');
                                updateBuyLink(productBox);
                            });
                            sizesContainer.appendChild(sizeButton);
                        });
                    }

                    productBox.querySelectorAll('.color-button').forEach(btn => btn.classList.remove('active-color'));
                    this.classList.add('active-color');
                });
            });
            const initialSizeButtons = document.querySelectorAll('.sizes button');
            initialSizeButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const sizesContainer = this.closest('.sizes');
                    sizesContainer.querySelectorAll('button').forEach(btn => btn.classList.remove('active-size'));
                    this.classList.add('active-size');
                    const productBox = this.closest('li');
                    updateBuyLink(productBox);
                });
            });

            function updateBuyLink(productBox) {
                const selectedSizeButton = productBox.querySelector('.sizes button.active-size');
                if (selectedSizeButton) {
                    const selectedSize = selectedSizeButton.dataset.size;
                    const buyLink = productBox.querySelector('.buy-btn');
                    const newHref = buyLink.dataset.route.replace(/size=\d+/, 'size=' + selectedSize); // Update size parameter
                    buyLink.setAttribute('href', newHref);
                }
            }
        });
    </script>
{% endblock %}
