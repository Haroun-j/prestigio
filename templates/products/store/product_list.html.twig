                <ul class="items">
                    {% for category in categories %}
                        {% for product in category.products %}

                            <li data-category="{{ category.label }}" data-price="{{ product.price }}">
                                <a href="{{ path('product_details', {id: product.id}) }}" style="text-decoration: none">
                                    <picture>
                                        <img id="{{ product.name|replace({' ': '-'}) }}"
                                             src="{{ asset('uploads/images/products/' ~ product.imageName) }}" alt="">
                                    </picture>
                                </a>
                                <div class="detail">
                                    <p class="icon">
                                        <span><i class="far fa-heart"></i></span>
                                        <span><i class="far fa-share-square"></i></span>
                                        <a href="{{ path('cart_add', {id: product.id, size : 40, quantity: 1, source: 'store'}) }}"
                                           style="text-decoration: none"><span><i
                                                        class="fas fa-shopping-basket"></i></span></a>
                                    </p>
                                    <strong>{{ product.name | length > 20 ? product.name | slice(0, 18) ~ '...' : product.name }}</strong>
                                    <span>{{ product.description | length > 70 ? product.description | slice(0, 70) ~ '...' : product.description }}</span>
                                    <div></div>
                                    <small><a style="text-decoration: none"
                                              href="{{ path('cart_add', {id: product.id, size : 42, quantity: 1, source: 'store'}) }}"
                                              class="buy-btn"
                                              data-route="{{ path('cart_add', {id: product.id, size : 42,quantity: 1, source: 'store'}) }}">Acheter</a></small>
                                </div>
                                <h4>${{ product.price }}</h4>
                            </li>

                        {% endfor %}
                    {% endfor %}
