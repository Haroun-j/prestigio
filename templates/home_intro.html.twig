{% block content %}
    <div id="overlay" style="display: none;"></div>
    <div id="video-popup" style="display: none">
        <span onclick="closeVideoPopup()" id="close-button">&times;</span>
        <video id="intro-video" autoplay muted onended="showRestartButton()">
            <source src="{{ asset('assets/videos/home_intro.mp4') }}" type="video/mp4" >
            Your browser does not support the video tag.
        </video>
        <button id="restart-button" onclick="restartVideo()">
            <img src="{{ asset('assets/images/restart_video.png') }}" alt="Restart Icon" width="30">
        </button>
    </div>
{% endblock %}
{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Wait for 3 seconds before showing the video popup
            setTimeout(showVideoPopup, 3000);
        });

        function showVideoPopup() {

            const overlay = document.getElementById('overlay');
            const videoPopup = document.getElementById('video-popup');
            videoPopup.style.display = 'block';
            overlay.style.display = 'block';
        }

        function closeVideoPopup() {
            const videoPopup = document.getElementById('video-popup');
            const overlay = document.getElementById('overlay');
            videoPopup.style.display = 'none';
            overlay.style.display = 'none';
        }

        function showRestartButton() {
            const restartButton = document.getElementById('restart-button');
            restartButton.style.display = 'block';
        }

        function restartVideo() {
            const video = document.getElementById('intro-video');
            video.currentTime = 0;
            video.play();
            const restartButton = document.getElementById('restart-button');
            restartButton.style.display = 'none';
        }
    </script>
{% endblock %}
{% block stylesheets %}
    <style>
        #overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 9998;
            display: none;
        }
        #video-popup {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 20px;
            border-radius: 10px;
            z-index: 9999;
        }

        #close-button {
            position: absolute;
            top: 4px;
            right: 8px;
            color: #fff;
            font-size: 30px;
            cursor: pointer;
        }

        #restart-button {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 10px;
            background: none;
            border: none;
            border-radius: 50%;
            cursor: pointer;
        }

        #restart-button img {
            width: 25%;
            height: auto;
        }

        #intro-video {
            width: 80vw;
            max-width: 800px;
            height: auto;
        }
        #restart-button:hover::before {
            content: "Recommencer";
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 14px;
            pointer-events: none;
        }
    </style>
{% endblock %}