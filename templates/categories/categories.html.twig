{% block categories %}
    <div class="container">
        <div class="row">
            <div class="col-md-12 ">
                <div class="titlepage">
                    <h2>TOP MARQUES</h2>
                    <span>looking at its layout. The point of using Lorem Ipsumletters, as opposed to usingl</span>
                </div>
            </div>
        </div>
    </div>
    <div class="categories-wrapper">
        <link href="{{ asset('assets/css/categories/categories-style.css') }}" rel="stylesheet">

        <button class="mode-switch" title="Switch Theme">
            <svg class="moon" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                 stroke-width="2" width="36" height="36" viewBox="0 0 24 24">
                <defs></defs>
                <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
            </svg>
        </button>
        <div class="category-container">
            <div class="box">
                <h2 class="name">Nike</h2>
                <a href="{{ path('store')}}" class="buy">Découvrir</a>
                <div class="circle"></div> {# you can try this too #0b38259e #}
                <img class="product" src="{{ asset('assets/images/products/nike_brand_showcase.png') }}"
                     alt="NIKE_Shoes"/>
            </div>
            <div class="box second_brand">
                <h2 class="name">Adidas</h2>
                <a href="{{ path('store')}}" class="buy">Découvrir</a>
                <div class="circle"></div>
                <img class="product" src="{{ asset('assets/images/products/Racer_TR23_.png') }}" alt="ADIDAS_Shoes"/>
            </div>
            <div class="box third_brand">
                <h2 class="name">Louis Vuitton</h2>
                <a href="{{ path('store')}}" class="buy">Découvrir</a>
                <div class="circle"></div>
                <img class="product" src="{{ asset('assets/images/products/Louis_Vuitton_brand_showcase.png') }}"
                     alt="LV_Shoes"/>
            </div>
            <script src="https://assets.codepen.io/7773162/vanilla-tilt.min.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', () => {

                    const boxes = document.querySelectorAll('.box');

                    const hoverClass = 'force-hover';

                    boxes.forEach(box => box.classList.add(hoverClass));

                    boxes.forEach(box => {
                        box.addEventListener('mouseenter', () => {
                            box.classList.remove(hoverClass);
                        });

                        box.addEventListener('mouseleave', () => {
                            box.classList.add(hoverClass);
                        });
                    });
                });
            </script>

            <script>
                document.querySelectorAll('.box').forEach(box => {
                    box.addEventListener('mouseenter', () => {
                        box.style.animation = 'none';
                    });

                    box.addEventListener('mouseleave', () => {
                        box.style.animation = '';
                    });
                });

                VanillaTilt.init(document.querySelectorAll(".box"), {
                    max: 15,
                    speed: 300,
                    easing: "cubic-bezier(.03,.98,.52,.99)",
                    scale: 1.05,
                });
            </script>
            <script src="{{ asset('assets/js/categories/categories.js') }}"></script>
        </div>
    </div>
{% endblock %}