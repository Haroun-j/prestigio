    <script src="https://cdnjs.cloudflare.com/ajax/libs/fullPage.js/4.0.22/fullpage.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fullPage.js/4.0.22/fullpage.extensions.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
    <!-- Footer-->
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check screen width
            var screenWidth = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;

            // Initialize fullpage.js only if screen width is greater than 600px
            if (screenWidth > 600) {
                // initialize fullpage.js
                new fullpage("#fullpage", {
                    autoScrolling: true,
                    scrollBar: true,
                    scrollOverflow: true,
                    responsiveWidth: 400,
                    navigation: true,
                    navigationTooltips: ["Accueil", "Gallerie", "Marques", "Partenaires", "Produits","En Promo","Contact"],
                    anchors: ["home", "gallery", "brands", "partners", "products","promo","contact"],
                    menu: "#myMenu",
                    fitToSection: false,
                    scrollingSpeed: 1000,
                    easingcss3: 'cubic-bezier(0.645, 0.045, 0.355, 1)',
                    dragAndMove: true,
                    afterLoad: function(origin, destination) {
                        var sectionAnchor = destination.anchor;
                        var navMenuLinks = document.querySelectorAll('.fp-tooltip');
                        if (sectionAnchor === 'brands' || sectionAnchor === 'partners' || sectionAnchor === 'products') {
                            navMenuLinks.forEach(function(link) {
                                link.style.color = '#007bff';
                            });
                        }else if(sectionAnchor === 'promo'){
                            navMenuLinks.forEach(function(link) {
                                link.style.color = '#FF0000';
                            });
                        } else {
                            navMenuLinks.forEach(function(link) {
                                link.style.color = '';
                            });
                        }
                    },
                });
            }

            // move section down one
            var moveDownButton = document.querySelector("#moveDown");
            if (moveDownButton) {
                moveDownButton.addEventListener("click", function() {
                    fullpage_api.moveSectionDown();
                });
            }

            // smooth scrolling
            var links = document.querySelectorAll('a[href*="#"]:not([href="#"])');
            links.forEach(function(link) {
                link.addEventListener("click", function(event) {
                    event.preventDefault();

                    var target = document.querySelector(this.hash);
                    target = target ? target : document.querySelector("[name=" + this.hash.slice(1) + "]");

                    if (target) {
                        var targetOffset = target.getBoundingClientRect().top + window.pageYOffset;
                        window.scrollTo({
                            top: targetOffset,
                            behavior: "smooth"
                        });
                    }
                });
            });
        });

    </script>


    <style>
        .section {
