<style>
    .promo-badge {
        position: absolute;
        top: 20px;
        right: 35px;
        background-color: red;
        color: white;
        padding: 5px 10px;
        border-radius: 50px;
        font-size: 45px;
        font-weight: bold;
        z-index: 10;
        /* Animation */
        animation: pulse 2s infinite ease-in-out;
    }

    @keyframes pulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(255, 0, 0, 0.7);
        }
        50% {
            transform: scale(1.1);
            box-shadow: 0 0 10px 10px rgba(255, 0, 0, 0);
        }
        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(255, 0, 0, 0);
        }
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/vanilla-tilt@1.7.0/dist/vanilla-tilt.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Color selection
        document.querySelectorAll('.card-item-colors--list .color').forEach(function (color) {
            color.addEventListener('click', function () {
                const list = this.parentElement.querySelectorAll('.color');
                list.forEach(function (c) {
                    c.removeAttribute('id');
                });
                this.setAttribute('id', 'activeColor');
            });
        });

        // Size selection
        document.querySelectorAll('.card-item-sizes--list span').forEach(function (span) {
            span.addEventListener('click', function () {
                const list = this.parentElement.querySelectorAll('span');
                list.forEach(function (size) {
                    size.removeAttribute('id');
                });
                this.setAttribute('id', 'activeSize');
            });
        });
    });


    function addToCart(element) {
        const index = element.className.match(/addToCartButton(\d+)/)[1];
        alert("Item " + index + " added to cart");
    }

</script>

<script>
    const cardItems = document.querySelectorAll('.card-item');
    cardItems.forEach(item => {
        VanillaTilt.init(item, {
            reverse: false,
            max: 13,
            perspective: 1000,
            scale: 1.05,
            speed: 1500,
            transition: true,
            axis: null,
            reset: true,
            easing: "cubic-bezier(.03,.98,.52,.99)",
        });
    });

    function toggleCard(element) {
        const parentDiv = element.closest('.flip-card-inner');
        parentDiv.classList.toggle('flip-card-active');
    }

    function goBack(element) {
        const parentDiv = element.closest('.flip-card-active');
        if (parentDiv) {
            parentDiv.classList.remove('flip-card-active');
        }
    }
</script>
