<div class="container">
    <div class="row">
        <div class="col-md-12 ">
            <div class="titlepage">
                <h2>Nos Produits</h2>
            </div>
        </div>
    </div>
    <div class="slider-container">
        <div class="slider-wrapper" id="productSlider">
            {% for product in featuredProducts %}
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 shoe-box" data-product-id="{{ product.id }}">
                    <div class="container_">
                        <div class="card">
                            <div class="sneaker">
                                <div class="circle"></div>
                                <img src="{{ asset('assets/images/products/home/' ~ product.name|replace({' ': '-'}) ~ '-cropped.png') }}"
                                     alt="{{ product.name }}" class="product-image"/>
                            </div>
                            <div class="info">
                                <h1 class="title"
                                    id="{{ product.name|replace({' ': '-'}) }}-title">{{ product.name }}</h1>
                                <h3 class="description">{{ product.description | slice(0,60) }}. . .</h3>
                                <div class="colors" style="margin-bottom: 8px;">
                                    <!-- Active color -->
                                    <button class="color-button active-color"
                                            style="background: {{ product.colorCode }};"
                                            data-color-code="{{ product.colorCode }}" data-variation-info='{{ {
                                        id: product.id,
                                        name: product.name,
                                        description: product.description,
                                        sizes: product.sizes,
                                        image: asset('assets/images/products/home/' ~ product.name|replace({' ': '-'}) ~ '-cropped.png')
                                    }|json_encode }}'></button>                          <!-- Other variations -->
                                    {% for variation in product.variations %}
                                        <button class="color-button" style="background: {{ variation.colorCode }};"
                                                data-color-code="{{ variation.colorCode }}" data-variation-info='{{ {
                                            id: variation.id,
                                            sizes: variation.sizes,
                                            image: asset('assets/images/products/home/product_variations/' ~ product.name|replace({' ': '-'}) ~ '/' ~ variation.color|replace({' ': '-'}) ~ '-cropped.png')
                                        }|json_encode }}'></button>
                                    {% endfor %}
                                </div>
                                <div class="sizes">
                                    {% for size in product.sizes %}
                                        <button data-size="{{ size.size }}">{{ size.size }}</button>
                                    {% endfor %}
                                </div>
                                <div class="purchase">
                                    <a href="{{ path('cart_add', {id: product.id, size : 40, quantity: 1, source: 'home'}) }}"
                                       class="buy-link"
                                       data-route="{{ path('cart_add', {id: product.id, size : 40, quantity: 1, source: 'home'}) }}">
                                        <button>Acheter</button>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <button id="slidePrev"></button>
    <button id="slideNext"></button>
</div>
<link rel="stylesheet" href="{{ asset('assets/css/products/home/products_style.css') }}">
<style>
    #Mercurial-Superfly-9-title {
        font-size: 1.4rem;
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        
        // For each shoe-box, store the original product id and initialize selectedVariationId.
        document.querySelectorAll('.shoe-box[data-product-id]').forEach(function (productBox) {
            productBox.dataset.originalProductId = productBox.dataset.productId;
            productBox.dataset.selectedVariationId = "";
        });
        
        // Auto-select default size in each sizes container, if none is active.
        document.querySelectorAll('.shoe-box .sizes').forEach(function (sizesContainer) {
            if (!sizesContainer.querySelector('button.active-size')) {
                const firstSizeButton = sizesContainer.querySelector('button');
                if (firstSizeButton) {
                    firstSizeButton.classList.add('active-size');
                    const productBox = sizesContainer.closest('.shoe-box');
                    updateBuyLink(productBox);
                }
            }
        });
        
        // Color button behavior.
        const colorButtons = document.querySelectorAll('.shoe-box .color-button');
        colorButtons.forEach(button => {
            button.addEventListener('click', function () {
                if (this.classList.contains('active-color')) {
                    return;
                }
                
                const productBox = this.closest('.shoe-box');
                const variationInfo = JSON.parse(this.dataset.variationInfo);
                
                // Update image.
                const img = productBox.querySelector('.product-image');
                if (img && variationInfo.image) {
                    img.src = variationInfo.image;
                }
                
                // Update sizes.
                const sizesContainer = productBox.querySelector('.sizes');
                sizesContainer.innerHTML = '';
                if (variationInfo.sizes && Array.isArray(variationInfo.sizes)) {
                    variationInfo.sizes.forEach(size => {
                        const sizeButton = document.createElement('button');
                        sizeButton.textContent = size.size;
                        sizeButton.dataset.size = size.size;
                        sizeButton.addEventListener('click', function () {
                            sizesContainer.querySelectorAll('button').forEach(btn => btn.classList.remove('active-size'));
                            this.classList.add('active-size');
                            updateBuyLink(productBox);
                        });
                        sizesContainer.appendChild(sizeButton);
                    });
                    // Auto-select the first new size.
                    const firstBtn = sizesContainer.querySelector('button');
                    if (firstBtn) {
                        firstBtn.classList.add('active-size');
                    }
                }
                
                // Set active state for color buttons.
                productBox.querySelectorAll('.color-button').forEach(btn => btn.classList.remove('active-color'));
                this.classList.add('active-color');
                
                // Instead of altering product id, store the variation id separately.
                if (variationInfo.id) {
                    productBox.dataset.selectedVariationId = variationInfo.id;
                } else {
                    productBox.dataset.selectedVariationId = "";
                }
                
                updateBuyLink(productBox);
            });
        });
        
        // Size button click behavior (for already-present sizes).
        document.querySelectorAll('.shoe-box .sizes button').forEach(button => {
            button.addEventListener('click', function () {
                const sizesContainer = this.closest('.sizes');
                sizesContainer.querySelectorAll('button').forEach(btn => btn.classList.remove('active-size'));
                this.classList.add('active-size');
                const productBox = this.closest('.shoe-box');
                updateBuyLink(productBox);
            });
        });
        
        // Ensure the "Acheter" link requires a size.
        document.querySelectorAll('.buy-link').forEach(buyLink => {
            buyLink.addEventListener('click', function (e) {
                const productBox = this.closest('.shoe-box');
                const selectedSize = productBox.querySelector('.sizes button.active-size');
                if (!selectedSize) {
                    e.preventDefault();
                    alert("Merci de sélectionner une taille");
                }
            });
        });
        
        // Update the buy link URL.
        function updateBuyLink(productBox) {
            const buyLinks = productBox.querySelectorAll('.buy-link');
            if (!buyLinks.length) return;
            
            // Start with the original route.
            let newHref = buyLinks[0].dataset.route;
            
            // Keep parent's id in the route.
            const originalProductId = productBox.dataset.originalProductId;
            if (originalProductId) {
                newHref = newHref.replace(/(\d+)/, originalProductId);
            }
            
            // Update the size parameter.
            const selectedSizeButton = productBox.querySelector('.sizes button.active-size');
            if (selectedSizeButton) {
                const selectedSize = selectedSizeButton.dataset.size;
                newHref = newHref.replace(/size=\d+/, 'size=' + selectedSize);
            }
            
            // Append or update the 'productVariationId' parameter.
            // Use the stored selected variation id, or "0" if none.
            const variationId = (productBox.dataset.selectedVariationId && productBox.dataset.selectedVariationId !== "")
                ? productBox.dataset.selectedVariationId
                : "0";
            try {
                let url = new URL(newHref, window.location.origin);
                url.searchParams.set('productVariationId', variationId);
                newHref = url.toString();
            } catch (error) {
                if (newHref.indexOf('?') === -1) {
                    newHref += '?productVariationId=' + variationId;
                } else {
                    newHref += '&productVariationId=' + variationId;
                }
            }
            
            buyLinks.forEach(function (link) {
                link.setAttribute('href', newHref);
            });
        }
    });
</script>
<script src="{{ asset('assets/js/products/home/products_script.js') }}"></script>
