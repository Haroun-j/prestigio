{% extends 'base.html.twig' %}

{% block main %}
    <div class="wrapper">

        <div class="content">
            
            <section class="left">
                <div class="swiper-container galleryMain ">
                    <div class="swiper-wrapper">
                    </div>
                
                </div>
                <!-- Add Arrows -->
                <div class="sliderNavigation">
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-pagination"></div>
                    <div class="swiper-button-next"></div>
                </div>
            </section>
            
            <section class="right">
                <div class="rightContent">
                    <div class="model">
                        <p class="modelTitle">{{ data.name }} </p>
                        <p class="modelDesc">{{ data.category }}</p>
                    </div>
                    
                    <div class="price">
                        <p class="priceFinal"></p>
                        <p class="priceOriginal" id="product-price" data-price="{{ data.price }}"></p>
                    </div>
                    
                    <div class="specs">
                        <div class="size">
                            <h3 class="subtitle">Taille</h3>
                            <div class="dropdown">
                                <div class="form dropContent">
                                    <p class="sizeNumber">40</p>
                                    <i class="icon arrowDrop">
                                        <img src="https://rafaelalucas.com/dailyui/12/assets/arrow-down.svg" alt="">
                                    </i>
                                </div>
                                <div class="dropOpen">
                                    <ul class="dropItems">
                                        {% for size in data.sizes %}
                                            <li class="dropItem">{{ size }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="quantity">
                            <h3 class="subtitle">quantité</h3>
                            <div class="form quantityCounter">
                                <input class="inputQuantity" onKeyDown="return false" type="number" value="1"/>
                                
                                <i class="icon btnQuantity minus">
                                    <img src="https://rafaelalucas.com/dailyui/12/assets/minus.svg" alt="">
                                </i>
                                <i class="icon btnQuantity plus">
                                    <img src="https://rafaelalucas.com/dailyui/12/assets/plus.svg" alt="">
                                </i>
                            </div>
                            
                            <p class="error">We only have 5 items in stock.</p>
                        </div>
                    </div>
                    <div class="swiper-container galleryThumbs">
                        <div class="swiper-wrapper">
                        </div>
                    </div>
                    <div class="btnContainer">
                        <a href="#" id="add-to-cart"
                           data-url="{{ path('cart_add', {id: data.id, size: 'SIZE', quantity: 'QUANTITY', source: 'product_details'}) }}"
                           class="btn add">
                            <img src="https://rafaelalucas.com/dailyui/12/assets/shopping-cart-w.svg" alt="">
                            Acheter
                        </a>
                    </div>
                
                </div>
            </section>
            <!-- Swiper -->
        
        </div>
        {{ include('@MercurySeriesFlashy/flashy.html.twig') }}
    </div>
    
    <link rel="stylesheet" href="{{ asset('assets/css/products/product_style.css') }}">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.5.0/js/swiper.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.5.0/js/swiper.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/parallax/3.1.0/parallax.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
    <script type="application/json" id="images-data">{{ data.images|json_encode|raw }}</script>
    <script src="{{ asset('assets/js/products/product_script.js') }}"></script>
{% endblock %}
